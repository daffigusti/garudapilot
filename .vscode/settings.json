{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.renderWhitespace": "trailing",
  "files.trimTrailingWhitespace": true,
  "search.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/__pycache__": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/__pycache__": true
  },
  "python.analysis.exclude": [
    "**/.git",
    "**/.venv",
    "**/__pycache__",
    // exclude directories that should be using the symlinked version
    "common/**",
    "selfdrive/**",
    "system/**",
    "third_party/**",
    "tools/**"
  ],
  "files.associations": {
    "*.embeddedhtml": "html",
    "__locale": "c",
    "print": "c",
    "safety_declarations.h": "c",
    "__verbose_abort": "c",
    "cstdio": "c",
    "__tree": "c",
    "bitset": "c",
    "set": "c",
    "common.h": "c",
    "logger.h": "c",
    "common_dbc.h": "c",
    "fake_stm.h": "c",
    "utils.h": "c",
    "stdio.h": "c",
    "safety.h": "c"
  },
  "python.languageServer": "None"
}
